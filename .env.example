# ---------------------------------------------------------------------------
# Feishu Open Platform credentials (https://open.feishu.cn/app -> 凭证与基础信息)
# ---------------------------------------------------------------------------
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Callback URL - must be added in 开发配置 -> 安全设置 -> 重定向 URL
FEISHU_REDIRECT_URI=http://127.0.0.1:8000/oauth/callback
# Space-separated OAuth scopes; request each one in 权限管理 first.
FEISHU_SCOPES="auth:user.id:read task:task:read task:task:write im:chat:readonly calendar:calendar:readonly wiki:wiki:readonly base:table:read base:record:retrieve base:record:create base:record:update base:record:delete base:field:read contact:contact.base:readonly contact:user.email:readonly offline_access"
# FEISHU_WIKI_NODE_TOKEN=xxxxxxxxxxxxxxxx  # wiki URL token (feishu.cn/wiki/<token>); resolved to the Bitable app_token automatically
# FEISHU_BITABLE_APP_TOKEN=xxxxxxxx  # or paste the app_token from a direct base URL (feishu.cn/base/<app_token>)
# Website task writes (needs base:record:create + base:record:update + base:field:read scopes).
# When a Bitable is configured this is REQUIRED: new tasks POST here so they appear on the board;
# without it creation is refused instead of silently using Feishu task-v2.
# FEISHU_BITABLE_SUBMIT_TABLE_ID=tbl...   # use the tracked 任务管理表 id
# Legacy deployments may set only FEISHU_BITABLE_TASKS_TABLE_ID; it is used as the submit-table fallback.
# Optional column-name overrides (defaults match the RoboMaster base):
# FEISHU_BITABLE_NAME_FIELD=任务名称
# FEISHU_BITABLE_TYPE_FIELD=兵种类型
# FEISHU_BITABLE_DIVISION_FIELD=研发组别
# FEISHU_BITABLE_REQUIREMENT_FIELD=任务需求（兵种组长填写）（务必详细！）
# FEISHU_BITABLE_DESC_FIELD=备注
# FEISHU_BITABLE_DDL_FIELD=ddl
# FEISHU_BITABLE_PRIORITY_FIELD=优先级
# FEISHU_BITABLE_OWNER_FIELD=负责人
# FEISHU_BITABLE_STATUS_FIELD=任务状态（由技术组长验收）
# FEISHU_BITABLE_DEFAULT_STATUS=待执行
# RM_AUTO_COLLECT_SECONDS=300   # background auto-collect (0 = disabled)
# FEISHU_MODE=live | mock (mock is offline and starts empty)
FEISHU_MODE=mock

# Optional collection scope (keep empty to collect everything reachable)
# FEISHU_CHAT_IDS=oc_xxxxxxxx oc_yyyyyyyy
# FEISHU_CALENDAR_ID=
# FEISHU_BITABLE_APP_TOKEN=
# FEISHU_TENANT_NAME=RoboMaster Research Team

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
DATABASE_PATH=data/larkai.sqlite3
FRONTEND_DIST=frontend/dist
HOST=127.0.0.1
PORT=8000
# Comma-separated open_ids allowed to manage tasks / run sync (empty = first
# user who logs in becomes admin)
FEISHU_ADMIN_OPEN_IDS=

# ---------------------------------------------------------------------------
# Email notifications (leave SMTP_* empty for dry-run: notifications are
# still recorded on the site but not delivered)
# ---------------------------------------------------------------------------
NOTIFY_EMAIL_FROM=rmtasks@example.com
NOTIFY_EMAIL_TO=manager@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
SMTP_SSL=0
# Send email on task create/cancel/complete events
NOTIFY_ON_TASK_CHANGE=1

# Cloudflare Access origin verification (set both in production).
# CF_ACCESS_ISSUER=https://hxyulin.cloudflareaccess.com
# CF_ACCESS_AUD=<application audience from Terraform>

# Herkules website sign-in (separate from the Feishu API connection).
# OIDC_ISSUER=https://herkules.dev/auth
# OIDC_CLIENT_ID=larkai
# OIDC_CLIENT_SECRET=<registered confidential client secret>
# PUBLIC_ORIGIN=https://dashboard.herkules.dev
# When OIDC is enabled, Herkules UserInfo owns admin roles; FEISHU_ADMIN_OPEN_IDS is ignored.

# Task graph: same-table Bitable link fields (read during sync, written only on explicit save).
FEISHU_BITABLE_PARENT_FIELD=父记录
FEISHU_BITABLE_DEPENDENCY_FIELD=前置/依赖
